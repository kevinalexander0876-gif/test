--====================================================--
-- VYRION SERVER LIVE
-- Strict POST allow-list with exact source validation.
--
-- Allowed categories:
--   Serpent/Whirlpool, SK, Hydra, Kraken, Set sail,
--   Ghost Ship, Pteranodon, Island-Race
--
-- IMPORTANT:
--   Serpent/Whirlpool -> ONLY workspace.Monster.Boss.Serpent OR workspace.SerpentWhirlpool
--   SK       -> ONLY workspace.SeaMonster.SeaKing
--   Hydra    -> ONLY workspace.SeaMonster.HydraSeaKing
--   Kraken   -> ONLY workspace.Monster.Boss.FuryTentacle
--   Pteranodon -> ONLY workspace.Monster.Boss["Pteranodon [Lv. 12500]"]
--   Ghost Ship -> ONLY workspace.GhostMonster["Ghost Ship"]
--   Island-Race -> ONLY recognized race-island objects in workspace.Island
--   Galleon is NEVER posted and can NEVER become Serpent.
--====================================================--
hs = game:GetService("HttpService")
req = http_request or request or (syn and syn.request)

_G.VyrionServerLiveAPI = "https://vyrion-server-live.ai.studio/api"
_G.VyrionServerLiveAPIKey = "API_VYRION_HUB_544_OMG"

local ServerLiveCategories = {
    "Serpent/Whirlpool",
    "SK",
    "Hydra",
    "Kraken",
    "Set sail",
    "Ghost Ship",
    "Pteranodon",
    "Island-Race"
}

local ServerLiveSelected = (_G.Setting.serverlive_select and _G.Setting.serverlive_select[1]) or "Serpent/Whirlpool"
