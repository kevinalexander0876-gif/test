--========================================================--
-- DUNGEON V1 | REBUILT TARGET + M1 + SKILL ENGINE
-- Keeps Easy/Normal/Hard selection and DungeonUI detection.
-- Movement stays at 11 studs with -90 degrees in normal combat.
-- Auto Dodge uses the same Dark/Flame/Ice/Gravity/Crab behavior
-- used by Dungeon V2 when its dodge toggle is enabled.
--========================================================--
local dungeonV1Target = nil
local dungeonV1TargetIndex = 0
local dungeonV1TargetClock = 0
local dungeonV1LastTeleport = 0
local dungeonV1AppliedTarget = nil
local dungeonV1SkillBusy = false
local dungeonV1SkillQueued = false
local dungeonV1SkillAction = game:GetService("ReplicatedStorage")
    :WaitForChild("Chest")
    :WaitForChild("Remotes")
    :WaitForChild("Functions")
    :WaitForChild("SkillAction")

local function dungeonV1GetTPSpeed()
    local speed = tonumber(_("dungeon_tpspeed")) or 50
    return math.clamp(speed, 1, 100)
end

local function dungeonV1GetTPInterval()
    -- 1 = slower repositioning, 100 = fastest repositioning.
    local speed = dungeonV1GetTPSpeed()
    return 0.09 - ((speed - 1) / 99) * 0.08
end

local function dungeonV1GetTargetInterval()
    local speed = dungeonV1GetTPSpeed()
    return 0.36 - ((speed - 1) / 99) * 0.30
end

local function dungeonV1IsActive()
    return _("dungeon")
        and _G.inraid
        and not _G.dungeon_bullet_dodge
end

local function dungeonV1GetLiveMobs(playerPosition)
    local mobFolder = game.Workspace:FindFirstChild("MOB")
    if not mobFolder then
        return {}
    end

    local live = {}
    for _, mob in ipairs(mobFolder:GetChildren()) do
        local humanoid = mob:FindFirstChildOfClass("Humanoid")
        local root = mob:FindFirstChild("HumanoidRootPart")
        if mob:IsA("Model") and humanoid and root and humanoid.Health > 0 then
            table.insert(live, mob)
        end
    end

    if playerPosition then
        table.sort(live, function(a, b)
            local ar = a:FindFirstChild("HumanoidRootPart")
            local br = b:FindFirstChild("HumanoidRootPart")
            if not ar then return false end
            if not br then return true end
            return (ar.Position - playerPosition).Magnitude < (br.Position - playerPosition).Magnitude
        end)
    end

    return live
end

local function dungeonV1FindTargetIndex(live, target)
    if not target then return nil end
    for i, mob in ipairs(live) do
        if mob == target then
            return i
        end
    end
    return nil
end

local function dungeonV1PickTarget(playerPosition)
    local live = dungeonV1GetLiveMobs(playerPosition)
    if #live == 0 then
        dungeonV1Target = nil
        dungeonV1TargetIndex = 0
        return nil
    end

    -- Once only one NPC is alive, stay on that NPC until its Health is 0.
    if #live == 1 then
        dungeonV1Target = live[1]
        dungeonV1TargetIndex = 1
        return dungeonV1Target
    end

    local currentIndex = dungeonV1FindTargetIndex(live, dungeonV1Target)
    local now = os.clock()
    local switchInterval = dungeonV1GetTargetInterval()

    if currentIndex and (now - dungeonV1TargetClock) < switchInterval then
        return dungeonV1Target
    end

    local nextIndex
    if currentIndex then
        nextIndex = currentIndex + 1
        if nextIndex > #live then
            nextIndex = 1
        end
    else
        nextIndex = 1
    end

    dungeonV1TargetIndex = nextIndex
    dungeonV1Target = live[nextIndex]
    dungeonV1TargetClock = now
    return dungeonV1Target
end

--========================================================--
-- DUNGEON V1 | AUTO DODGE DATA
-- Same alert detection pattern used by the V2 dodge system,
-- but kept narrow and only applied to the active V1 target.
--========================================================--
local dungeonV1DodgeEffect = nil
local dungeonV1DodgeKind = nil

-- Dungeon V1:
-- Normal position = 11 studs above the target.
-- When a danger effect is detected, move 40 studs away from it.
local DUNGEON_V1_NORMAL_HEIGHT = 11
local DUNGEON_V1_DODGE_DISTANCE = 40
local DUNGEON_V1_DODGE_RADIUS = 100

local function dungeonV1EffectPosition(obj)
    if not obj then return nil end

    if obj:IsA("BasePart") then
        return obj.Position
    end

    local part = obj:FindFirstChildWhichIsA("BasePart", true)
    return part and part.Position or nil
end

local function dungeonV1GetDangerType(name)
    name = string.lower(tostring(name))

    if name:find("darkpullhand", 1, true)
        or name:find("pull", 1, true) then
        return "pull"
    end

    if name:find("meteor", 1, true)
        or name:find("meteo", 1, true) then
        return "meteor"
    end

    if name:find("ice", 1, true) then
        return "ice"
    end

    return nil
end

-- Searches Workspace.Effects, including nested objects/models.
-- The dodge remains active while the detected object is still inside Effects.
local function dungeonV1FindDangerEffect(targetRoot)
    if not targetRoot then
        return nil, nil
    end

    local effects = game.Workspace:FindFirstChild("Effects")
    if not effects then
        return nil, nil
    end

    local bestEffect = nil
    local bestDistance = nil
    local bestKind = nil

    for _, topLevel in ipairs(effects:GetChildren()) do
        local objects = {topLevel}

        for _, descendant in ipairs(topLevel:GetDescendants()) do
            table.insert(objects, descendant)
        end

        for _, effect in ipairs(objects) do
            local kind = dungeonV1GetDangerType(effect.Name)

            if kind then
                local position = dungeonV1EffectPosition(effect)

                if position then
                    local distance = (position - targetRoot.Position).Magnitude

                    if distance <= DUNGEON_V1_DODGE_RADIUS
                        and (not bestDistance or distance < bestDistance) then
                        bestEffect = effect
                        bestDistance = distance
                        bestKind = kind
                    end
                end
            end
        end
    end

    return bestEffect, bestKind
end

