-- Auto Reset Finish Dungeon:
-- Works with Dungeon V1 or V2. It uses the same Workspace.MOB folder
-- used by the existing dungeon farm and only arms on the final floor.
vyrion_is_final_floor = function()
    local plg = game.Players.LocalPlayer:FindFirstChild("PlayerGui")
    if not plg then
        return false
    end

    local dungeonUI = plg:FindFirstChild("DungeonUI")
    if not dungeonUI then
        return false
    end

    -- Try common text-bearing descendants first. This avoids relying on
    -- a single exact UI object name while still requiring an explicit 5/5.
    for _, obj in ipairs(dungeonUI:GetDescendants()) do
        if obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then
            local value = tostring(obj.Text or "")
            if value:find("5/5", 1, true) or value:match("^%s*5%s*/%s*5%s*$") then
                return true
            end
        end
    end

    return false
end

