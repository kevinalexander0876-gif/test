local function getSerpentSword()
    local player = game.Players.LocalPlayer
    local character = player.Character
    local backpack = player:FindFirstChild("Backpack")

    if character then
        for _, tool in ipairs(character:GetChildren()) do
            if tool:IsA("Tool") and tool.ToolTip == "Sword" then
                return tool
            end
        end
    end

    local savedName = _("serpent_sword")
    if backpack and savedName ~= "" then
        local saved = backpack:FindFirstChild(savedName)
        if saved and saved:IsA("Tool") and saved.ToolTip == "Sword" then
            return saved
        end
    end

    if backpack then
        for _, tool in ipairs(backpack:GetChildren()) do
            if tool:IsA("Tool") and tool.ToolTip == "Sword" then
                return tool
            end
        end
    end
end

local function isToolEquipped(weaponName)
    local character = game.Players.LocalPlayer.Character
    local tool = character and character:FindFirstChild(weaponName)
    return tool and tool:IsA("Tool") or false
end

local function equipWeaponEtc(weaponName)
    if not weaponName or weaponName == "" then return end

    local player = game.Players.LocalPlayer
    local character = player.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    local backpack = player:FindFirstChild("Backpack")

    -- If the requested tool is already equipped, NEVER fire EtcFunction.
    if isToolEquipped(weaponName) then return end

    -- If the requested tool already exists in Backpack, equip that exact
    -- instance locally. This prevents repeatedly firing EtcFunction just
    -- because the weapon is currently sitting in Backpack.
    if backpack and humanoid then
        local backpackTool = backpack:FindFirstChild(weaponName)
        if backpackTool and backpackTool:IsA("Tool") then
            humanoid:EquipTool(backpackTool)
            return
        end
    end

    -- Only call the server equip event when the requested tool is not
    -- already equipped and is not already available in Backpack.
    local args = {
        [1] = "EquipWeapon",
        [2] = {
            ["WeaponName"] = weaponName,
            ["Type"] = "Primary"
        }
    }
    game:GetService("ReplicatedStorage"):WaitForChild("Chest"):WaitForChild("Remotes"):WaitForChild("Functions"):WaitForChild("EtcFunction"):InvokeServer(unpack(args))
end

local function saveCurrentSerpentSword(updateButton)
    local sword = getSerpentSword()
    if not sword then return nil end
    __("serpent_sword", sword.Name)
    -- The button only receives the sword name when the user explicitly
    -- presses it while Auto Kill Serpent is enabled.
    if updateButton and f_b3 then f_b3.Text = sword.Name end
    return sword.Name
end

