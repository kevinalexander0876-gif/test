--========================================================--
-- VYRION | AUTO CONQUEST ENGINE
-- Flag state: workspace.FlagConquest.<Flag>.Beam.BillboardGui.TextLabel
-- <ON COOLDOWN> = skip flag
-- <NONE> = capture and wait for Popup "Flag captured!"
-- Player <= 5 studs = abandon current flag immediately
--========================================================--
do
    local Players = game:GetService("Players")
    local RunService = game:GetService("RunService")
    local TeleportService = game:GetService("TeleportService")
    local HttpService = game:GetService("HttpService")
    local LocalPlayer = Players.LocalPlayer

    local CONQUEST_PLAYER_DISTANCE = 5
    local CONQUEST_POLL = 0.04
    local CONQUEST_HOP_RETRIES = 5
    local CONQUEST_HOP_WAIT = 2
    local CONQUEST_HOP_START_DELAY = 3

    local function getCharacterRoot(player)
        local character = player and player.Character
        return character and character:FindFirstChild("HumanoidRootPart")
    end

    local function getFlagLabel(flag)
        local beam = flag and flag:FindFirstChild("Beam")
        local billboard = beam and beam:FindFirstChild("BillboardGui")
        return billboard and billboard:FindFirstChild("TextLabel")
    end

    local function flagIsCooldown(flag)
        local label = getFlagLabel(flag)
        if not label then return false end
        local ok, text = pcall(function() return tostring(label.Text or "") end)
        return ok and string.find(string.upper(text), "ON COOLDOWN", 1, true) ~= nil
    end

    local function getFlags()
        local folder = workspace:FindFirstChild("FlagConquest")
        if not folder then return {} end
        local flags = {}
        for _, flag in ipairs(folder:GetChildren()) do
            if string.match(flag.Name, "^FlagConquest%d+$") then
                table.insert(flags, flag)
            end
        end
        table.sort(flags, function(a, b)
            return (tonumber(string.match(a.Name, "%d+")) or math.huge) <
                   (tonumber(string.match(b.Name, "%d+")) or math.huge)
        end)
        return flags
    end

    local function playerWithinFiveStuds()
        local localRoot = getCharacterRoot(LocalPlayer)
        if not localRoot then return false end
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer then
                local root = getCharacterRoot(player)
                if root and (root.Position - localRoot.Position).Magnitude <= CONQUEST_PLAYER_DISTANCE then
                    return true
                end
            end
        end
        return false
    end

    -- Returns true when the character is outside the active capture area.
    -- The capture area is taken directly from Beam.Size, e.g. 25,1,25.
    local function isOutsideFlagBeam(flag)
        local root = getCharacterRoot(LocalPlayer)
        local beam = flag and flag:FindFirstChild("Beam")
        if not root or not beam or not beam:IsA("BasePart") then return true end

        local size = beam.Size
        local localPos = beam.CFrame:PointToObjectSpace(root.Position)
        local halfX = math.max(math.abs(size.X) / 2, 2)
        local halfZ = math.max(math.abs(size.Z) / 2, 2)
        local vertical = math.max(math.abs(size.Y) / 2 + 6, 8)

        return math.abs(localPos.X) > halfX
            or math.abs(localPos.Z) > halfZ
            or math.abs(localPos.Y) > vertical
    end

    local function antiPush()
        local root = getCharacterRoot(LocalPlayer)
        if root then
            pcall(function()
                root.Anchored = true
                root.AssemblyLinearVelocity = Vector3.zero
                root.AssemblyAngularVelocity = Vector3.zero
            end)
        end
    end

    local function releaseAnchor()
        local root = getCharacterRoot(LocalPlayer)
        if root then
            pcall(function()
                root.Anchored = false
            end)
        end
    end

    local function refreshConquestAfterTeleport()
        -- Refresh the toggle immediately after each TP: OFF -> wait 2s -> ON.
        -- If the user disabled Conquest during the wait, do not turn it back on.
        if not _G.m_b7 then return true end

        m_b7.Text = ""
        _G.m_b7 = false
        releaseAnchor()

        task.wait(2)

        if not (_G.Setting.conquest and _G.Setting.conquest[1] == true) then
            return false
        end

        _G.m_b7 = true
        m_b7.Text = "X"
        return true
    end

    local function teleportToFlag(flag)
        local root = getCharacterRoot(LocalPlayer)
        if not root or not flag then return false end
        local part = flag:FindFirstChildWhichIsA("BasePart", true)
        if not part then return false end

        -- Re-check the flag immediately before every teleport.
        if flagIsCooldown(flag) then return false end

        pcall(function() root.Anchored = false end)

        -- Put the character about 2 studs above the actual ground below the flag.
        local targetPosition = part.Position + Vector3.new(0, 2, 0)
        pcall(function()
            local params = RaycastParams.new()
            params.FilterType = Enum.RaycastFilterType.Exclude
            params.FilterDescendantsInstances = {flag, LocalPlayer.Character}
            local rayOrigin = part.Position + Vector3.new(0, 100, 0)
            local hit = workspace:Raycast(rayOrigin, Vector3.new(0, -200, 0), params)
            if hit then
                targetPosition = hit.Position + Vector3.new(0, 2, 0)
            end
        end)

        root.CFrame = CFrame.new(targetPosition)
        pcall(function() root.Anchored = true end)

        -- Force the requested toggle refresh after the TP.
        return refreshConquestAfterTeleport()
    end

    local function popupVisible()
        local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
        local popup = playerGui and playerGui:FindFirstChild("Popup")
        local frame = popup and popup:FindFirstChild("Frame")
        local captured = frame and frame:FindFirstChild("Flag captured!")
        if not captured then return false end
        local okVisible, visible = pcall(function() return captured.Visible end)
        if okVisible and visible then return true end
        local okText, text = pcall(function() return tostring(captured.Text or "") end)
        return okText and string.find(string.lower(text), "flag captured!", 1, true) ~= nil
    end

    local function waitForCaptureOrPlayer()
        -- Require the popup to become hidden first, so an old "Flag captured!"
        -- notification cannot be mistaken for the current flag.
        while _G.m_b7 and popupVisible() do
            if playerWithinFiveStuds() then return "PLAYER" end
            antiPush()
            task.wait(CONQUEST_POLL)
        end

        -- Stay on this flag until a fresh "Flag captured!" popup appears,
        -- or another player gets within 5 studs. No capture timeout is used.
        while _G.m_b7 do
            if playerWithinFiveStuds() then return "PLAYER" end
            if popupVisible() then return "CAPTURED" end

            -- If the player is pushed/teleported outside the Beam.Size capture
            -- area, immediately return to the same flag. This also fixes the
            -- first capture after entering a new server.
            if isOutsideFlagBeam(_G.__VyrionCurrentConquestFlag) then
                local currentFlag = _G.__VyrionCurrentConquestFlag
                if currentFlag and not flagIsCooldown(currentFlag) then
                    teleportToFlag(currentFlag)
                end
            end

            antiPush()
            task.wait(CONQUEST_POLL)
        end
        return "OFF"
    end

    local function flagIsNone(flag)
        local label = getFlagLabel(flag)
        if not label then return true end
        local ok, text = pcall(function() return tostring(label.Text or "") end)
        if not ok then return true end
        text = string.upper(text)
        return string.find(text, "<NONE>", 1, true) ~= nil
            or string.match(text, "^%s*NONE%s*$") ~= nil
    end

    local function flagsReadyForHop()
        local flags = getFlags()
        if #flags == 0 then return false end
        -- Never hop while a flag is still <NONE>; give the server time to
        -- finish replicating its conquest state first.
        for _, flag in ipairs(flags) do
            if flagIsNone(flag) then return false end
            if not flagIsCooldown(flag) then return false end
        end
        return true
    end

    local function allFlagsOnCooldown()
        return flagsReadyForHop()
    end

    -- Conquest uses the exact same Server Hop entry point as the Teleport tab.
    -- The Teleport tab runs this external hop routine, so Conquest reuses it
    -- instead of maintaining a second Roblox server-list implementation.
    local function teleportTabServerHop()
        local ok, hop = pcall(function()
            return loadstring(game:HttpGet("https://raw.githubusercontent.com/NTTTTTTTT/Main/main/Svv"))
        end)
        if not ok or type(hop) ~= "function" then
            return false
        end
        return pcall(hop)
    end

    local conquestHopBusy = false
    local function conquestServerHop()
        if conquestHopBusy or not _G.m_b8 then return false end
        conquestHopBusy = true

        -- Never attempt a hop while any flag is still <NONE>.
        if not _G.m_b7 or not flagsReadyForHop() then
            conquestHopBusy = false
            return false
        end

        -- Wait a few seconds AFTER the fresh flag check before the first hop.
        task.wait(CONQUEST_HOP_START_DELAY)
        if not _G.m_b7 or not _G.m_b8 or not flagsReadyForHop() then
            conquestHopBusy = false
            return false
        end

        -- Five attempts using the exact Server Hop logic from Teleport.
        -- If the first call does not leave the server, retry the same routine.
        for attempt = 1, CONQUEST_HOP_RETRIES do
            if not _G.m_b7 or not _G.m_b8 then break end
            if not flagsReadyForHop() then break end

            teleportTabServerHop()

            if attempt < CONQUEST_HOP_RETRIES then
                task.wait(CONQUEST_HOP_WAIT)
            end
        end

        conquestHopBusy = false
        return false
    end

    local function runConquest()
        while _G.m_b7 do
            local flags = getFlags()
            local foundAvailable = false

            for _, flag in ipairs(flags) do
                if not _G.m_b7 then break end

                -- Check ON COOLDOWN immediately before every teleport.
                if not flagIsCooldown(flag) then
                    foundAvailable = true

                    -- Check once more just before the actual teleport.
                    if not flagIsCooldown(flag) and not playerWithinFiveStuds() then
                        _G.__VyrionCurrentConquestFlag = flag
                        if teleportToFlag(flag) then
                            local result = waitForCaptureOrPlayer()
                            _G.__VyrionCurrentConquestFlag = nil
                            if result == "OFF" then return end
                            -- CAPTURED or PLAYER: continue to the next flag.
                        else
                            _G.__VyrionCurrentConquestFlag = nil
                        end
                    end
                end
            end

            -- If every flag currently says ON COOLDOWN, hop only when Auto Hop Conquest is enabled.
            if not foundAvailable and _G.m_b8 then
                conquestServerHop()
            else
                task.wait(0.05)
            end
        end
    end

    RunService.Heartbeat:Connect(function()
        if _G.m_b7 then
            antiPush()
        else
            releaseAnchor()
        end
    end)

    pcall(function()
        TeleportService.TeleportInitFailed:Connect(function()
            if _G.m_b7 then
                task.spawn(function()
                    task.wait(1)
                    if _G.m_b8 and allFlagsOnCooldown() then
                        conquestServerHop()
                    else
                        pcall(function() TeleportService:Teleport(game.PlaceId, LocalPlayer) end)
                    end
                end)
            end
        end)
    end)

    task.spawn(function()
        while task.wait(0.1) do
            if _G.m_b7 and not _G.__VyrionConquestRunning then
                _G.__VyrionConquestRunning = true
                task.spawn(function()
                    pcall(runConquest)
                    _G.__VyrionConquestRunning = false
                end)
            end
        end
    end)

    -- After a Server Hop/rejoin, wait for FlagConquest to replicate and then
    -- make sure Auto Conquest starts on an available flag.
    task.spawn(function()
        while task.wait(0.5) do
            if _G.m_b7 then
                local flags = getFlags()
                if #flags > 0 and not _G.__VyrionCurrentConquestFlag then
                    for _, flag in ipairs(flags) do
                        if _G.m_b7 and not flagIsCooldown(flag) then
                            if isOutsideFlagBeam(flag) then
                                teleportToFlag(flag)
                            end
                            break
                        end
                    end
                end
            end
        end
    end)
end

