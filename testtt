local vu196 = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
local function vu205(p197)
    return (p197:gsub(".", function(p198)
        local v199 = p198:byte()
        local v200 = ""
        for v201 = 8, 1, - 1 do
            v200 = v200 .. (v199 % 2 ^ v201 - v199 % 2 ^ (v201 - 1) > 0 and "1" or "0")
        end
        return v200
    end) .. "0000"):gsub("%d%d%d?%d?%d?%d?", function(p202)
        if # p202 < 6 then
            return ""
        end
        local v203 = 0
        for v204 = 1, 6 do
            v203 = v203 + (p202:sub(v204, v204) == "1" and 2 ^ (6 - v204) or 0)
        end
        return vu196:sub(v203 + 1, v203 + 1)
    end) .. ({
        "",
        "==",
        "="
    })[# p197 % 3 + 1]
end
local function vu214(p206)
    return p206:gsub("[^" .. vu196 .. "=]", ""):gsub(".", function(p207)
        if p207 == "=" then
            return ""
        end
        local v208 = vu196:find(p207) - 1
        local v209 = ""
        for v210 = 6, 1, - 1 do
            v209 = v209 .. (v208 % 2 ^ v210 - v208 % 2 ^ (v210 - 1) > 0 and "1" or "0")
        end
        return v209
    end):gsub("%d%d%d?%d?%d?%d?%d?%d?", function(p211)
        if # p211 ~= 8 then
            return ""
        end
        local v212 = 0
        for v213 = 1, 8 do
            v212 = v212 + (p211:sub(v213, v213) == "1" and 2 ^ (8 - v213) or 0)
        end
        return string.char(v212)
    end)
end
local function vu221(p215, p216)
    local v217 = {}
    for v218 = 1, # p215 do
        local v219 = string.byte(p216, (v218 - 1) % # p216 + 1)
        local v220 = string.byte(p215, v218)
        table.insert(v217, string.char(bit32.bxor(v220, v219)))
    end
    return table.concat(v217)
end
