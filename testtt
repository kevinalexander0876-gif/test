--====================================================--
-- AUTO FISH | FishingBackground-length tracking + stretch
--
-- FishingBackground is the authoritative horizontal track.
-- While Auto Fish is active we ALWAYS re-acquire FishingBar through
-- getnilinstances() first, then fall back to the normal UI hierarchy.
--
-- IMPORTANT:
--   * FishingBar is forced to the SAME HORIZONTAL LENGTH as
--     FishingBackground (X = 100% of its parent).
--   * We do NOT copy AbsoluteSize into Size. AbsoluteSize is used only
--     to verify the rendered result; Size is expressed relative to the
--     FishingBackground parent with UDim2.new(1, 0, ...).
--   * The check is continuous while Auto Fish is enabled, but Size is
--     only written when the current rendered width is actually different.
--   * FishLabel is read continuously from FishingBackground and its
--     current AbsolutePosition/AbsoluteSize are used every frame.
--   * The bar only changes position when the fish center REALLY leaves
--     the current usable horizontal area.
--====================================================--
do
    local Players = game:GetService("Players")
    local RunService = game:GetService("RunService")
    local LocalPlayer = Players.LocalPlayer

    local function getNil(name, class)
        if type(getnilinstances) ~= "function" then
            return nil
        end

        for _, obj in next, getnilinstances() do
            if obj.ClassName == class and obj.Name == name then
                return obj
            end
        end

        return nil
    end

    local lastBar
    local lastBackground
    local stretchUntil = 0

    local function getFishingObjects()
        local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
        if not playerGui then
            return nil, nil, nil
        end

        -- Primary layout shown by the game's Explorer:
        -- PlayerGui > FishingUI > FishingBackground > FishLabel/FishingBar
        local fishingUI = playerGui:FindFirstChild("FishingUI")
        local background = fishingUI and fishingUI:FindFirstChild("FishingBackground", true)

        -- Compatibility with versions where FishingBackground is directly
        -- under PlayerGui.
        if not background then
            background = playerGui:FindFirstChild("FishingBackground", true)
        end

        if not background or not background:IsA("GuiObject") then
            return nil, nil, nil
        end

        local fishLabel = background:FindFirstChild("FishLabel", true)

        -- The requested lookup is intentionally performed on EVERY active
        -- update. Roblox can destroy/recreate FishingBar after a successful
        -- catch, so we must never keep a stale nil-instance reference.
        local nilBar = getNil("FishingBar", "Frame")
        local fishingBar = nil

        -- Prefer the bar that actually belongs to the CURRENT
        -- FishingBackground. This is important because getnilinstances()
        -- can contain an older FishingBar from the previous fishing round.
        local currentBar = background:FindFirstChild("FishingBar", true)
        if currentBar and currentBar:IsA("GuiObject") then
            fishingBar = currentBar
        elseif nilBar and nilBar:IsA("GuiObject") then
            -- Only use the nil-instance result when it is not stale.
            fishingBar = nilBar
        end

        if not fishingBar or not fishingBar:IsA("GuiObject") then
            fishingBar = nil
        end

        return fishLabel, fishingBar, background
    end

    local function stretchFishingBar(fishingBar, background)
        if not fishingBar or not background then
            return
        end

        -- This is the intended relationship: FishingBar must have the same
        -- horizontal length as FishingBackground. In the shown hierarchy
        -- they share the same parent, so X = 1, 0 is exact and resolution-safe.
        if fishingBar.Parent ~= background then
            return
        end

        local backgroundWidth = background.AbsoluteSize.X
        local barWidth = fishingBar.AbsoluteSize.X

        if backgroundWidth <= 0 then
            return
        end

        -- Avoid writing Size every frame. Only correct it when the rendered
        -- width differs from the background by at least half a pixel.
        if math.abs(barWidth - backgroundWidth) > 0.5
            or fishingBar.Size.X.Scale ~= 1
            or fishingBar.Size.X.Offset ~= 0 then

            local currentYScale = fishingBar.Size.Y.Scale
            local currentYOffset = fishingBar.Size.Y.Offset

            fishingBar.Size = UDim2.new(1, 0, currentYScale, currentYOffset)
        end
    end

    local function resetCache(bar, background)
        -- A new fishing round normally creates a fresh FishingBar. Give the
        -- replacement a short correction window because Roblox may first
        -- render it with its default width and only then finish the UI.
        if bar ~= lastBar or background ~= lastBackground then
            lastBar = bar
            lastBackground = background
            stretchUntil = os.clock() + 1.25
        end
    end

    RunService.RenderStepped:Connect(function(dt)
        if not _("fish") then
            lastBar = nil
            lastBackground = nil
            return
        end

        local fishLabel, fishingBar, background = getFishingObjects()
        if not background or not fishingBar then
            return
        end

        resetCache(fishingBar, background)

        -- FIRST: keep FishingBar the same horizontal length as the
        -- FishingBackground. The correction is continuous, and is also
        -- forced repeatedly for a short period whenever a NEW FishingBar
        -- appears after the previous fish has been caught.
        stretchFishingBar(fishingBar, background)
        if os.clock() < stretchUntil then
            -- Roblox can overwrite Size during the recreation/layout pass;
            -- immediately re-check the live object instead of requiring the
            -- user to disable/enable Auto Fish.
            stretchFishingBar(fishingBar, background)
        end

        if not fishLabel or not fishLabel:IsA("GuiObject") then
            return
        end

        -- ALWAYS re-read current rendered dimensions/positions after the
        -- possible Size correction above.
        local bgPos = background.AbsolutePosition
        local bgSize = background.AbsoluteSize
        local barPos = fishingBar.AbsolutePosition
        local barSize = fishingBar.AbsoluteSize
        local fishPos = fishLabel.AbsolutePosition
        local fishSize = fishLabel.AbsoluteSize

        local trackWidth = bgSize.X
        local barWidth = barSize.X
        local fishWidth = fishSize.X

        if trackWidth <= 0 or barWidth <= 0 or fishWidth <= 0 then
            return
        end

        -- FishingBackground defines the usable horizontal length.
        local trackLeft = bgPos.X
        local trackRight = trackLeft + trackWidth

        -- Since FishingBar is stretched to the same width, its movement
        -- range is normally zero. Keep the generic calculation in place so
        -- the code remains safe if the game changes the hierarchy later.
        local minBarLeft = trackLeft
        local maxBarLeft = math.max(trackLeft, trackRight - barWidth)
        local currentBarLeft = math.clamp(barPos.X, minBarLeft, maxBarLeft)

        local fishCenter = fishPos.X + (fishWidth * 0.5)
        local barRight = currentBarLeft + barWidth

        -- Tiny tolerance prevents sub-pixel animation from causing jitter.
        local tolerance = math.max(1, math.min(3, barWidth * 0.02))

        -- Fish is still inside the bar: do nothing.
        if fishCenter >= currentBarLeft + tolerance
            and fishCenter <= barRight - tolerance then
            return
        end

        -- Only when the fish actually exits do we calculate a new position.
        local targetLeft = fishCenter - (barWidth * 0.5)
        targetLeft = math.clamp(targetLeft, minBarLeft, maxBarLeft)

        local response = math.clamp(dt * 14, 0, 1)
        local newX = currentBarLeft + (targetLeft - currentBarLeft) * response

        if math.abs(targetLeft - newX) < 0.5 then
            newX = targetLeft
        end

        local parent = fishingBar.Parent
        if not parent or not parent:IsA("GuiObject") then
            return
        end

        local pos = fishingBar.Position
        local parentSizeX = parent.AbsoluteSize.X
        local parentLeft = parent.AbsolutePosition.X

        if parentSizeX <= 0 then
            return
        end

        local desiredOffset = newX - parentLeft - (pos.X.Scale * parentSizeX)

        fishingBar.Position = UDim2.new(
            pos.X.Scale,
            desiredOffset,
            pos.Y.Scale,
            pos.Y.Offset
        )
    end)
end

