local function VyrionServerLiveRequest(method, url, body)
    if not req then return nil end
    local ok, response = pcall(function()
        local options = {
            Url = url,
            Method = method,
            Headers = { ["Content-Type"] = "application/json" }
        }
        if _G.VyrionServerLiveAPIKey and _G.VyrionServerLiveAPIKey ~= "" then
            options.Headers["x-api-key"] = _G.VyrionServerLiveAPIKey
        end
        if body then options.Body = hs:JSONEncode(body) end
        return req(options)
    end)
    return ok and response or nil
end

local function VyrionAddUnique(list, value)
    if type(value) ~= "string" or value == "" then return end
    for _, existing in ipairs(list) do
        if existing == value then return end
    end
    table.insert(list, value)
end

local function VyrionAlive(model)
    if not model then return false end
    local hum = model:FindFirstChildOfClass("Humanoid")
    return (not hum) or hum.Health > 0
end

-- Collect exact event names + their strict category aliases.
-- This restores the old multi-event POST behaviour while preventing
-- generic Monster.Boss objects (especially Galleon) from leaking into it.
local function VyrionCollectLiveEvents()
    local events, categories = {}, {}
    local ws = game:GetService("Workspace")

    local function addEvent(name, category)
        VyrionAddUnique(events, name)
        VyrionAddUnique(categories, category)
    end

    -- 1) Serpent / Whirlpool: ONE combined category.
    -- Any verified Serpent or SerpentWhirlpool presence is indexed under
    -- the same dropdown entry so both states appear in the same server list.
    pcall(function()
        local monster = ws:FindFirstChild("Monster")
        local boss = monster and monster:FindFirstChild("Boss")
        local serpent = boss and boss:FindFirstChild("Serpent")
        local whirlpool = ws:FindFirstChild("SerpentWhirlpool")
        local serpentAlive = serpent and VyrionAlive(serpent)

        if serpentAlive then
            addEvent("Serpent", "Serpent/Whirlpool")
        end
        if whirlpool then
            addEvent("SerpentWhirlpool", "Serpent/Whirlpool")
        end
    end)

    -- 3) SK and 4) Hydra: exact SeaMonster objects only.
    pcall(function()
        local seaMonster = ws:FindFirstChild("SeaMonster")
        if not seaMonster then return end

        local sk = seaMonster:FindFirstChild("SeaKing")
        if sk and VyrionAlive(sk) then
            addEvent(sk.Name, "SK")
        end

        local hydra = seaMonster:FindFirstChild("HydraSeaKing")
        if hydra and VyrionAlive(hydra) then
            addEvent(hydra.Name, "Hydra")
        end
    end)

    -- 5) Kraken: exact FuryTentacle path only.
    pcall(function()
        local monster = ws:FindFirstChild("Monster")
        local boss = monster and monster:FindFirstChild("Boss")
        local kraken = boss and boss:FindFirstChild("FuryTentacle")
        if kraken and VyrionAlive(kraken) then
            addEvent(kraken.Name, "Kraken")
        end
    end)

    -- 6) Set sail: restore recognized SeaMonster event objects, but
    -- explicitly exclude Galleon and every object already assigned above.
    pcall(function()
        local seaMonster = ws:FindFirstChild("SeaMonster")
        if not seaMonster then return end

        for _, obj in ipairs(seaMonster:GetChildren()) do
            local n = string.lower(obj.Name)
            local excluded =
                n:find("galleon", 1, true)
                or obj.Name == "SeaKing"
                or obj.Name == "HydraSeaKing"
                or n:find("serpent", 1, true)
                or n:find("whirlpool", 1, true)
                or n:find("kraken", 1, true)
                or n:find("ghost", 1, true)
                or n:find("pteranodon", 1, true)
                or obj:FindFirstChild("done")

            if not excluded and obj:FindFirstChild("HumanoidRootPart") and VyrionAlive(obj) then
                addEvent(obj.Name, "Set sail")
            end
        end
    end)

    -- 7) Ghost Ship: exact path/name only.
    pcall(function()
        local ghostMonster = ws:FindFirstChild("GhostMonster")
        local ghost = ghostMonster and ghostMonster:FindFirstChild("Ghost Ship")
        if ghost and ghost:FindFirstChild("HumanoidRootPart") and VyrionAlive(ghost) then
            addEvent(ghost.Name, "Ghost Ship")
        end
    end)

    -- 8) Pteranodon: exact path/name only.
    pcall(function()
        local monster = ws:FindFirstChild("Monster")
        local boss = monster and monster:FindFirstChild("Boss")
        local ptera = boss and boss:FindFirstChild("Pteranodon [Lv. 12500]")
        if ptera and VyrionAlive(ptera) then
            addEvent(ptera.Name, "Pteranodon")
        end
    end)

    -- 9) Island-Race: restore exact object names from the Island folder.
    -- Only the known race-island naming families are accepted.
    pcall(function()
        local island = ws:FindFirstChild("Island")
        if not island then return end

        for _, obj in ipairs(island:GetChildren()) do
            local n = string.lower(obj.Name)
            local raceIsland =
                n:find("human", 1, true)
                or n:find("gale", 1, true)
                or n:find("seaking", 1, true)
                or n:find("angel", 1, true)
                or n:find("animal", 1, true)
                or n:find("fish", 1, true)
                or n:find("demon", 1, true)

            if raceIsland then
                addEvent(obj.Name, "Island-Race")
            end
        end
    end)

    return events, categories
end

local function VyrionServerLiveHeartbeat()
    if not _G.VyrionServerLiveAPI or _G.VyrionServerLiveAPI == "" then return end

    local events, categories = VyrionCollectLiveEvents()
    if #events == 0 and #categories == 0 then return end

    -- POST all verified events/categories currently present. Never fabricate
    -- a category from an unrelated boss name.
    local indexed = {}
    for _, name in ipairs(events) do VyrionAddUnique(indexed, name) end
    for _, name in ipairs(categories) do VyrionAddUnique(indexed, name) end

    local players = game:GetService("Players")
    VyrionServerLiveRequest("POST", _G.VyrionServerLiveAPI .. "/servers", {
        placeId = game.PlaceId,
        jobId = game.JobId,
        players = #players:GetPlayers(),
        maxPlayers = players.MaxPlayers,
        bosses = indexed,
        timestamp = os.time()
    })
end

