    local dragInput = nil
    local dragStart = nil
    local startPosition = nil
    local startAbsolutePosition = nil
    local moved = false
    local DRAG_THRESHOLD = 8

    local function updatePosition(input)
        local delta = input.Position - dragStart
        local camera = workspace.CurrentCamera
        local viewport = camera and camera.ViewportSize or Vector2.new(1920, 1080)
        local size = vu146.AbsoluteSize

        -- ScreenGui uses screen coordinates, so calculate the new
        -- absolute position directly. This also works correctly on mobile.
        local x = startAbsolutePosition.X + delta.X
        local y = startAbsolutePosition.Y + delta.Y

        x = math.clamp(x, 0, math.max(0, viewport.X - size.X))
        y = math.clamp(y, 0, math.max(0, viewport.Y - size.Y))

        vu146.Position = UDim2.fromOffset(x, y)
    end

    vu146.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then

            dragging = true
            moved = false
            dragStart = input.Position
            startPosition = vu146.Position
            startAbsolutePosition = vu146.AbsolutePosition

            if input.UserInputType == Enum.UserInputType.Touch then
                dragInput = input
            end
        end
    end)

    vu146.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if not dragging or input ~= dragInput then
            return
        end

        local delta = input.Position - dragStart
        if delta.Magnitude >= DRAG_THRESHOLD then
            moved = true
            updatePosition(input)
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType ~= Enum.UserInputType.MouseButton1
            and input.UserInputType ~= Enum.UserInputType.Touch then
            return
        end

        if not dragging then
            return
        end

        local wasMoved = moved
        dragging = false
        dragInput = nil
        dragStart = nil
        startPosition = nil
        startAbsolutePosition = nil
        moved = false

        -- Short tap/click = toggle. Drag = only move, never toggle.
        if not wasMoved then
            pu144.Visible = not pu144.Visible
        end
    end)
end
