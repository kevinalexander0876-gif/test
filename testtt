local function vyrion_sea_event_exists()
    -- Only a real, currently spawned and alive qualifying event in Workspace
    -- can trigger Priority. Galleon/Galeon is never a trigger.
    local ws = game.Workspace
    local whirlpool = ws:FindFirstChild("SerpentWhirlpool")
    if whirlpool then
        return true
    end

    local monster = ws:FindFirstChild("Monster")
    local bossFolder = monster and monster:FindFirstChild("Boss")
    local serpent = bossFolder and bossFolder:FindFirstChild("Serpent")
    if serpent then
        local root = serpent:FindFirstChild("HumanoidRootPart")
        local hum = serpent:FindFirstChildOfClass("Humanoid")
        if root and (not hum or hum.Health > 0) then return true end
    end

    local seaMonster = ws:FindFirstChild("SeaMonster")
    if seaMonster then
        for _, obj in ipairs(seaMonster:GetChildren()) do
            local n = string.lower(obj.Name)
            if not (n:find("galleon", 1, true) or n:find("galeon", 1, true)) then
                local root = obj:FindFirstChild("HumanoidRootPart")
                if root then
                    local hum = obj:FindFirstChildOfClass("Humanoid")
                    if not hum or hum.Health > 0 then return true end
                end
            end
        end
    end

    local kraken = bossFolder and bossFolder:FindFirstChild("FuryTentacle")
    if kraken then
        local root = kraken:FindFirstChild("HumanoidRootPart")
        local hum = kraken:FindFirstChildOfClass("Humanoid")
        if root and (not hum or hum.Health > 0) then return true end
    end
    return false
end

