-- Detect Roblox connection-loss/server-failure prompts and reconnect to the same
-- experience. This is deliberately guarded by the Auto Reconnect toggle.
local AutoReconnectPlayers = game:GetService("Players")
local AutoReconnectTeleportService = game:GetService("TeleportService")
local AutoReconnectGuiService = game:GetService("GuiService")
local AutoReconnectCoreGui = game:GetService("CoreGui")
local autoReconnectBusy = false
local autoReconnectLast = 0

local function autoReconnectNow()
    if not _G.st_b12 or autoReconnectBusy then return end
    if os.clock() - autoReconnectLast < 8 then return end
    autoReconnectLast = os.clock()
    autoReconnectBusy = true

    task.spawn(function()
        -- Give Roblox a moment to finish the disconnect prompt before rejoining.
        task.wait(1.5)
        if not _G.st_b12 then
            autoReconnectBusy = false
            return
        end

        for attempt = 1, 6 do
            if not _G.st_b12 then break end
            local ok = pcall(function()
                AutoReconnectTeleportService:Teleport(game.PlaceId, AutoReconnectPlayers.LocalPlayer)
            end)
            if ok then
                -- Teleport() normally hands control to Roblox; if it fails silently,
                -- retry after a short delay.
                task.wait(2.5)
            else
                task.wait(1.5)
            end
        end

        autoReconnectBusy = false
    end)
end

local function autoReconnectMessageLooksLikeDisconnect(message)
    local text = string.lower(tostring(message or ""))
    if text == "" then return false end
    return text:find("error code 277", 1, true)
        or text:find("error code 279", 1, true)
        or text:find("disconnected", 1, true)
        or text:find("lost connection", 1, true)
        or text:find("connection lost", 1, true)
        or text:find("failed to connect", 1, true)
        or text:find("server is shutting down", 1, true)
        or text:find("server has shut down", 1, true)
end

pcall(function()
    AutoReconnectGuiService.ErrorMessageChanged:Connect(function(message)
        if autoReconnectMessageLooksLikeDisconnect(message) then
            autoReconnectNow()
        end
    end)
end)

-- Some Roblox disconnects are shown through the CoreGui prompt overlay instead
-- of ErrorMessageChanged, so watch newly-created prompt text as a second path.
pcall(function()
    local promptGui = AutoReconnectCoreGui:FindFirstChild("RobloxPromptGui")
    local overlay = promptGui and promptGui:FindFirstChild("promptOverlay")
    if overlay then
        overlay.DescendantAdded:Connect(function(obj)
            if obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then
                if autoReconnectMessageLooksLikeDisconnect(obj.Text) then
                    autoReconnectNow()
                end
            end
        end)
    end
end)

