local function dungeonV1GetDodgeCFrame(target)
    local root = target and target:FindFirstChild("HumanoidRootPart")
    if not root then
        return nil
    end

    local base = root.Position

    local normalCF =
        CFrame.new(base + Vector3.new(0, DUNGEON_V1_NORMAL_HEIGHT, 0))
        * CFrame.Angles(math.rad(-90), 0, 0)

    if not _("dodgev2") then
        return normalCF
    end

    local effect = dungeonV1DodgeEffect

    -- Stay in dodge mode until the detected effect actually disappears
    -- from Workspace.Effects.
    if effect and effect.Parent then
        local effectsFolder = game.Workspace:FindFirstChild("Effects")
        local stillInEffects = effectsFolder and effect:IsDescendantOf(effectsFolder)

        if stillInEffects then
            local effectPos = dungeonV1EffectPosition(effect)

            if effectPos then
                local away = base - effectPos
                away = Vector3.new(away.X, 0, away.Z)

                if away.Magnitude < 0.1 then
                    away = Vector3.new(1, 0, 0)
                end

                away = away.Unit

                local dodgePos =
                    base
                    + away * DUNGEON_V1_DODGE_DISTANCE
                    + Vector3.new(0, DUNGEON_V1_NORMAL_HEIGHT, 0)

                return CFrame.new(dodgePos)
                    * CFrame.Angles(math.rad(-90), 0, 0)
            end
        end
    end

    return normalCF
end

